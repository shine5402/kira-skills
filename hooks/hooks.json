{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/plugins/kira-copilot-review-hooks/hooks/block-copilot-mention.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/plugins/kira-copilot-review-hooks/hooks/hint-copilot-review-check.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/plugins/kira-copilot-review-hooks/hooks/hint-pr-ready-monitor.py"
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}\"/plugins/kira-copilot-review-hooks/hooks/hint-stale-gh.py"
          }
        ]
      }
    ]
  }
}
